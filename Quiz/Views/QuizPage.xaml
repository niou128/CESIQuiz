<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quiz.Views.QuizPage"
             Title="Quiz">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ProgressText}"
                   FontAttributes="Bold"
                   FontSize="18" />

            <Border Padding="16"
                    StrokeThickness="1"
                    IsVisible="{Binding HasActiveQuestion}"
                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding CurrentQuestion.Category}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />
                    <Label Text="{Binding CurrentQuestion.Text}"
                           FontSize="24"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding AnswerOptions}"
                        IsVisible="{Binding HasActiveQuestion}"
                        SelectionMode="None"
                        HeightRequest="340">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Text}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="18"
                            Padding="14"
                            CornerRadius="18"
                            HeightRequest="150"
                            BackgroundColor="{Binding BackgroundColor}"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                            CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="12" VerticalOptions="End">
            <Button Text="Question suivante"
                    Command="{Binding NextQuestionCommand}"
                    IsVisible="{Binding CanMoveNext}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="Tomato"
                   IsVisible="{Binding HasStatusMessage}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
